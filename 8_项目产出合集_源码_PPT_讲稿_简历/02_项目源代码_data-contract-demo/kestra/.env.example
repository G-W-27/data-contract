# 复制本文件为 .env（同目录），填入真实值后使用。
# .env 已在 .gitignore 中，不会被提交。

# PostgreSQL 容器与 Kestra 数据源共用的数据库口令（必填）
POSTGRES_PASSWORD=请填写你的数据库口令

# Kestra 连接 PostgreSQL 的库名与用户名（docker-compose 中已给出默认值，可留空沿用）
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# 钉钉机器人 Webhook（可选）
# 留空则 Kestra 流程不会推送钉钉告警，其余功能不受影响
DINGTALK_WEBHOOK=

# 说明：
# docker-compose.yml 中所有口令相关项均为 ${...} 引用，
# 未设置时 Docker Compose 会直接报错并提示，不会带着空口令启动。
